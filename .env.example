# Twilio credentials (from console.twilio.com)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567   # the number Twilio calls FROM

# OpenAI (Realtime API access required)
OPENAI_API_KEY=your_openai_api_key_here

# The number our bot will call TO (kept as config, not hardcoded)
TARGET_PHONE_NUMBER=+18054398008

# Public URL for this server, used so Twilio can reach our WebSocket bridge.
# In local dev this is your ngrok URL (e.g. https://abcd1234.ngrok-free.app)
PUBLIC_SERVER_URL=

# Local server port
PORT=8000